### Chess Tournament API - HTTP Requests Collection
### Compatible with REST Client for VS Code / IntelliJ / Postman

@baseUrl = http://localhost:5000
@adminEmail = your_admin@example.com
@adminPassword = YourAdminPassword123!

###
### 1. AUTHENTICATION & REGISTRATION
###

# 1.1 Admin Login
# @name adminLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### Store Admin Auth Token
@adminToken = {{adminLogin.response.body.token}}

# 1.2 Register a new PLAYER
# Fields: full_name, email, password, confirm_password, date_of_birth (age >= 5),
# gender (MALE|FEMALE|OTHER|UNDISCLOSED), phone (optional), country,
# experience_level (BEGINNER|INTERMEDIATE|ADVANCED|EXPERT), club (optional), fide_id (optional), accept_terms
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "role": "PLAYER",
  "full_name": "Hikaru Nakamura",
  "email": "hikaru@chess.example",
  "password": "PlayerPass123!",
  "confirm_password": "PlayerPass123!",
  "date_of_birth": "1987-12-09",
  "gender": "MALE",
  "phone": "+15551234567",
  "country": "USA",
  "experience_level": "EXPERT",
  "club": "Saint Louis Chess Club",
  "fide_id": "2016192",
  "accept_terms": true
}

# 1.3 Register a new ORGANIZER
# Fields: full_name, email, password, confirm_password, phone (required), organization, country, accept_terms
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "role": "ORGANIZER",
  "full_name": "FIDE Arbiter",
  "email": "arbiter@fide.example",
  "password": "ArbiterPass123!",
  "confirm_password": "ArbiterPass123!",
  "phone": "+15559876543",
  "organization": "World Chess Federation",
  "country": "Switzerland",
  "accept_terms": true
}

# 1.4 Verify Email (transitions status from PENDING_EMAIL to ACTIVE; approval_status stays PENDING)
POST {{baseUrl}}/api/auth/verify-email
Content-Type: application/json

{
  "token": "REPLACE_WITH_HEX_TOKEN_FROM_EMAIL_OR_CONSOLE"
}

# 1.5 Resend Verification Email (60s cooldown per account)
POST {{baseUrl}}/api/auth/resend-verification
Content-Type: application/json

{
  "email": "hikaru@chess.example"
}

# 1.6 Player Login (returns approval_status, approval_note, permissions object)
# @name playerLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "hikaru@chess.example",
  "password": "PlayerPass123!"
}

### Store Player Token
@playerToken = {{playerLogin.response.body.token}}

# 1.7 Google Sign-In (OAuth2 ID Token verification)
POST {{baseUrl}}/api/auth/google
Content-Type: application/json

{
  "id_token": "REPLACE_WITH_GOOGLE_ID_TOKEN",
  "role": "PLAYER"
}

# 1.8 Forgot Password (generic 200 response)
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{
  "email": "hikaru@chess.example"
}

# 1.9 Reset Password
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json

{
  "token": "REPLACE_WITH_RESET_TOKEN",
  "password": "NewSecretPass123!",
  "confirm_password": "NewSecretPass123!"
}

# 1.10 Get Current User Profile (GET /me)
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{adminToken}}

# 1.11 Update Current User Profile (PUT /me/profile)
# Supports full_name, phone, organization, country, date_of_birth, gender, experience_level, club, fide_id
PUT {{baseUrl}}/api/auth/me/profile
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "full_name": "Chief Tournament Arbiter",
  "phone": "+10987654321",
  "organization": "FIDE Global Operations"
}

# 1.12 Change Password
POST {{baseUrl}}/api/auth/change-password
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "current_password": "{{adminPassword}}",
  "new_password": "NewAdminPass123!"
}


###
### 2. ADMIN USER & APPROVAL MANAGEMENT (ADMIN ONLY)
###

# 2.1 List Users (supports role, approval_status, status, q, limit, offset)
GET {{baseUrl}}/api/admin/users?role=ORGANIZER&approval_status=PENDING&status=ACTIVE&limit=20&offset=0
Authorization: Bearer {{adminToken}}

# 2.2 Get User by ID (includes linked player chess profile and tournament count for organizers)
GET {{baseUrl}}/api/admin/users/2
Authorization: Bearer {{adminToken}}

# 2.3 Edit User Account / Linked Player Profile
# Allowed user fields: full_name, phone, organization
# Allowed linked player fields: name, country, date_of_birth, gender, experience_level, club, fide_id
# Rating, email, role, password CANNOT be edited here
PUT {{baseUrl}}/api/admin/users/2
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "full_name": "Updated Arbiter Name",
  "phone": "+15550001122",
  "organization": "National Chess Federation"
}

# 2.4 Approve User (sets approval_status=APPROVED, approved_by, approved_at; sets starting rating for fresh players)
# For PLAYER with no games yet: applies starting_rating (100..3500) or default by experience_level (1000/1200/1500/1800)
POST {{baseUrl}}/api/admin/users/2/approve
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "starting_rating": 1500
}

# 2.5 Reject User (sets approval_status=REJECTED and approval_note, sends email)
POST {{baseUrl}}/api/admin/users/2/reject
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "note": "Incomplete verification documents provided"
}

# 2.6 Suspend User Account
POST {{baseUrl}}/api/admin/users/2/suspend
Authorization: Bearer {{adminToken}}

# 2.7 Reactivate User Account
POST {{baseUrl}}/api/admin/users/2/reactivate
Authorization: Bearer {{adminToken}}

# 2.8 Change User Role (ADMIN cannot change own role)
POST {{baseUrl}}/api/admin/users/2/role
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "role": "ORGANIZER"
}


###
### 3. PLAYERS & PRIVACY RULES
###

# 3.1 List all players (Protected - requires active user)
# Email/phone/dob masked unless caller is ADMIN, own player, or organizer with tournament enrollment access
GET {{baseUrl}}/api/players
Authorization: Bearer {{adminToken}}

# 3.2 Search players by name
GET {{baseUrl}}/api/players?q=Magnus
Authorization: Bearer {{adminToken}}

# 3.3 Create a new walk-in player (ORGANIZER or ADMIN only)
POST {{baseUrl}}/api/players
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Levon Aronian",
  "email": "levon.aronian@example.com",
  "country": "USA",
  "date_of_birth": "1982-10-06",
  "gender": "MALE",
  "experience_level": "EXPERT",
  "current_rating": 2729
}

# 3.4 Get player by ID
GET {{baseUrl}}/api/players/1
Authorization: Bearer {{adminToken}}

# 3.5 Update player by ID (PLAYER can only update own profile; ADMIN/ORGANIZER can edit unlinked players)
PUT {{baseUrl}}/api/players/1
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "country": "Norway"
}

# 3.6 Direct Rating Edit Blocked (Fails with 400 - rating changes ONLY via record_result or initial approval)
PUT {{baseUrl}}/api/players/1
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "current_rating": 2900
}

# 3.7 Get player analytics
GET {{baseUrl}}/api/players/1/analytics
Authorization: Bearer {{adminToken}}


###
### 4. TOURNAMENTS
###

# 4.1 List all tournaments
GET {{baseUrl}}/api/tournaments
Authorization: Bearer {{adminToken}}

# 4.2 Create tournament (Requires APPROVED ORGANIZER or ADMIN)
POST {{baseUrl}}/api/tournaments
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Reykjavik Open 2026",
  "format": "SWISS",
  "start_date": "2026-05-01",
  "end_date": "2026-05-10",
  "status": "UPCOMING"
}

# 4.3 Get tournament by ID
GET {{baseUrl}}/api/tournaments/1
Authorization: Bearer {{adminToken}}

# 4.4 Update tournament / Change status (Creator or ADMIN only)
PUT {{baseUrl}}/api/tournaments/1
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "ONGOING"
}

# 4.5 Register player for tournament by Organizer/Admin
POST {{baseUrl}}/api/tournaments/1/register
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "player_id": 1
}

# 4.6 Player Self-Registration (Requires APPROVED PLAYER, UPCOMING tournaments only)
POST {{baseUrl}}/api/tournaments/1/register-me
Authorization: Bearer {{playerToken}}

# 4.7 Get all registrations for tournament (sensitive fields masked per privacy view v_organizer_player_access)
GET {{baseUrl}}/api/tournaments/1/registrations
Authorization: Bearer {{adminToken}}

# 4.8 Remove a player registration (ADMIN any; ORGANIZER only own tournaments; only while tournament is UPCOMING)
DELETE {{baseUrl}}/api/tournaments/1/registrations/1
Authorization: Bearer {{adminToken}}

# 4.9 Create a new tournament round (Auto-increments round_no, Creator or ADMIN only, requires ONGOING)
POST {{baseUrl}}/api/tournaments/1/rounds
Authorization: Bearer {{adminToken}}

# 4.10 Get all rounds for tournament
GET {{baseUrl}}/api/tournaments/1/rounds
Authorization: Bearer {{adminToken}}

# 4.11 Get tournament standings (from v_leaderboard)
GET {{baseUrl}}/api/tournaments/1/standings
Authorization: Bearer {{adminToken}}

# 4.12 Get tournament analytics
GET {{baseUrl}}/api/tournaments/1/analytics
Authorization: Bearer {{adminToken}}

# 4.13 Get tournament predictions
GET {{baseUrl}}/api/tournaments/1/predictions
Authorization: Bearer {{adminToken}}


###
### 5. ROUNDS & GAMES
###

# 5.1 Create game in round (Creator or ADMIN only)
POST {{baseUrl}}/api/rounds/1/games
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "board_no": 5,
  "white_player_id": 1,
  "black_player_id": 2
}

# 5.2 Get all games for round
GET {{baseUrl}}/api/rounds/1/games
Authorization: Bearer {{adminToken}}

# 5.3 Record game result (Creator or ADMIN only - executes CALL record_result(?, ?))
POST {{baseUrl}}/api/games/1/result
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "outcome": "WHITE"
}


###
### 6. DASHBOARDS
###

# 6.1 Role-Specific User Dashboard (GET /api/me/dashboard)
# PLAYER: profile summary, approval_status, current rating, rating_history (last 10), performance, enrollments, open_tournaments, pending_games
# ORGANIZER: approval_status, my_tournaments (with progress), enrolled_players count, recent_results
# ADMIN: user counts by role/approval/status, top 10 v_pending_approvals, tournaments by status, recent audit logs
GET {{baseUrl}}/api/me/dashboard
Authorization: Bearer {{adminToken}}

# 6.2 Public Platform Dashboard Overview
GET {{baseUrl}}/api/dashboard
Authorization: Bearer {{adminToken}}


###
### 7. ERROR HANDLING & SECURITY DEMONSTRATIONS
###

# 7.1 Unauthenticated Request -> 401
GET {{baseUrl}}/api/players

# 7.2 Unapproved Player / Organizer Blocked -> 403 { code: "NOT_APPROVED" }
POST {{baseUrl}}/api/tournaments/1/register-me
Authorization: Bearer {{playerToken}}

# 7.3 Direct Rating Edit Blocked -> 400 Bad Request
PUT {{baseUrl}}/api/players/1
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "current_rating": 3000
}
